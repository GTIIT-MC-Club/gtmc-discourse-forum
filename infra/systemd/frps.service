# 境外 VPS：/etc/systemd/system/frps.service
# 生效：`sudo systemctl daemon-reload && sudo systemctl enable --now frps`，之后 `systemctl status frps`。
# 官方 release 压缩包里也带了一份 frps.service（内容与这份接近），二选一，不要两份同时启用。

[Unit]
Description=frp server (VPS entry, forwards FORUM_HOST traffic to the forum machine)
# frps 要在网络就绪后才绑定 7000 和 8880；network-online.target 保证开机自启时不会因为没网而反复重启
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 端口都大于 1024，不需要 root；nobody 没有可写的家目录，减少被利用后的影响范围
User=nobody

Restart=on-failure
# 5 秒足够让上一轮的端口释放，又不至于断线太久
RestartSec=5s

ExecStart=/usr/bin/frps -c /etc/frp/frps.toml
# 每条隧道是一个长连接，200 用户规模下几百个 fd 够了，这里给足余量避免高并发时 EMFILE
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
